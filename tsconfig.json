{
    "include": ["**/*.ts", "**/*.tsx"],
    "exclude": ["dist", "server.ts"],
    "compilerOptions": {
        "lib": ["DOM", "DOM.Iterable", "ESNext"],
        "target": "ESNext",
        "module": "ESNext",
        "types": ["@types/node", "@types/bun", "vite-plus/client", "@hiogawa/vite-plugin-fullstack/types"],
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "jsxImportSource": "remix/component",
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowImportingTsExtensions": true,

        "checkJs": true,
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "strict": true,
        "noEmit": true,
        "paths": {
            "~/*": ["./app/*"]
        }
    }
}
