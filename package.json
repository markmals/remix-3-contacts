{
    "name": "remix-3-contacts",
    "private": true,
    "type": "module",
    "main": "index.js",
    "packageManager": "pnpm@10.29.3",
    "scripts": {
        "dev": "pnpm run --filter '.' --parallel '/^dev:/'",
        "dev:server": "NODE_ENV=development tsx watch server.ts",
        "dev:browser": "esbuild src/assets/*.tsx --outbase=src/assets --outdir=public/assets --bundle --minify --splitting --format=esm --entry-names='[dir]/[name]' --chunk-names='chunks/[name]-[hash]' --sourcemap --watch",
        "start": "tsx server.ts",
        "typecheck": "tsgo --noEmit",
        "fmt": "biome format --write .",
        "lint": "biome lint --write --unsafe ."
    },
    "dependencies": {
        "@types/sort-by": "^1.2.3",
        "better-sqlite3": "^12.6.2",
        "match-sorter": "^8.2.0",
        "remix": "github:remix-run/remix#preview/main&path:packages/remix",
        "sort-by": "^1.2.0"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.15",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.2.3",
        "@typescript/native-preview": "latest",
        "esbuild": "^0.27.3",
        "tsx": "^4.21.0"
    }
}
